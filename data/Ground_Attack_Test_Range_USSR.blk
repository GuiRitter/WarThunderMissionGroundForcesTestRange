triggers{
  isCategory:b=yes
  is_enabled:b=yes

  trigger_unlimited_power{
    is_enabled:b=yes
    comments:t=""

    props{
      actionsType:t="PERFORM_ONE_BY_ONE"
      conditionsType:t="ALL"
      enableAfterComplete:b=yes
    }

    events{
      periodicEvent{
        time:r=0.1
      }
    }

    conditions{
    }

    actions{
      unitRestore{
        ressurectIfDead:b=no
        fullRestore:b=no
        target:t="armada_player"
        ammoRestore:b=yes
      }
    }

    else_actions{
    }
  }

