      _Conq3:b=no
      _Conq4:b=no
      _Conq5:b=no
      _Conq6:b=no
      _DBttl:b=no
    }
  }

  spectator_points{
  }

  cover_points{
  }

  aiParams{
    aiEffectivenessViscosity:r=90
    effectivenessDistances:p2=2500, 7000
  }
}

