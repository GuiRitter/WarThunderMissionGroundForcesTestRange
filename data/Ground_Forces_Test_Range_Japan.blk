selected_tag:t=""
bin_dump_file:t=""

mission_settings{
  atmosphere{
    pressure:r=760
    temperature:r=15
  }

  stars{
    latitude:r=0
    longitude:r=0
    year:i=1940
    month:i=3
    day:i=20
  }

  player{
    army:i=1
    wing:t="armada_player"
  }

  player_teamB{
    army:i=2
  }

  mission{
    name:t="Ground_Forces_Test_Range_Japan"
    level:t="levels/flatlands.bin"
    type:t="singleMission"
    restoreType:t="attempts"
    optionalTakeOff:b=no
    campaign:t="UserMissions"
    environment:t="12"
    weather:t="clear"
    missionDebriefing:t=""
    missionBriefing:t=""

