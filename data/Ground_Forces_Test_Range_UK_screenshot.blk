selected_tag:t=""
bin_dump_file:t=""

mission_settings{
  atmosphere{
    pressure:r=760
    temperature:r=15
  }

  stars{
    latitude:r=0
    longitude:r=0
    year:i=1940
    month:i=3
    day:i=20
  }

  player{
    army:i=1
    wing:t="armada_player"
  }

  player_teamB{
    army:i=2
  }

  mission{
    name:t="Ground_Forces_Test_Range_UK_Screenshot"
