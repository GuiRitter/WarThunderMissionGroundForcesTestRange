bin_dump_file:t=""

mission_settings{
  atmosphere{
    pressure:r=760
    temperature:r=15
  }

  stars{
    latitude:r=48
    longitude:r=44
    year:i=1940
    month:i=1
    day:i=15
    time:r=12
  }

  player{
    army:i=1
    wing:t="armada_player"
  }

